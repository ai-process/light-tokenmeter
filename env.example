# Database
DATABASE_URL=postgres://tokenmeter:tokenmeter@localhost:5432/tokenmeter?sslmode=disable

# Server addresses
GRPC_ADDR=:9090
HTTP_ADDR=:8080
# Prometheus /metrics and /healthz; empty turns them off.
METRICS_ADDR=:9091

# Authentication: name:scope[+scope]:sha256hex entries, comma-separated.
# Hash a token with: printf %s "$TOKEN" | openssl dgst -sha256 -r. Empty turns auth off.
TOKENMETER_TOKENS=
TOKENMETER_TOKENS_FILE=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_ENABLE_TRACING=false
SENTRY_DEBUG=false
SENTRY_WITH_BREADCRUMBS=false

# Application
SHUTDOWN_TIMEOUT=30s
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ClickHouse (optional, high-scale analytics)
CLICKHOUSE_ENABLED=false
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=tokenmeter
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_BATCH_SIZE=5000
CLICKHOUSE_FLUSH_INTERVAL=1s
