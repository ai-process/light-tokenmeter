# Database
DATABASE_URL=postgres://tokenmeter:tokenmeter@localhost:5432/tokenmeter?sslmode=disable

# Server addresses
GRPC_ADDR=:9090
HTTP_ADDR=:8080

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_ENABLE_TRACING=false
SENTRY_DEBUG=false
SENTRY_WITH_BREADCRUMBS=false

# Application
SHUTDOWN_TIMEOUT=30s
DB_MAX_CONNS=25
DB_MIN_CONNS=5
